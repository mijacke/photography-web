{
    "regions": ["fra1"],
    "redirects": [
        {
            "source": "/:path(.*)",
            "has": [{ "type": "host", "value": "paulifotografka.sk" }],
            "destination": "https://www.paulifotografka.sk/:path",
            "permanent": true
        }
    ],
    "crons": [
        {
            "path": "/api/cron/refresh-instagram-token",
            "schedule": "0 9 1,15 * *"
        }
    ]
}

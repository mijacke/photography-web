{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "www.paulifotografka.sk"
                }
            ],
            "destination": "https://paulifotografka.sk/$1",
            "permanent": true
        }
    ],
    "crons": [
        {
            "path": "/api/cron/refresh-instagram-token",
            "schedule": "0 9 1,15 * *"
        }
    ]
}
